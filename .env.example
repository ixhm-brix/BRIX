# Munyakazi assistant service. Leave VITE_ASSISTANT_URL unset and the widget
# falls back to displaying published prices/FAQ with a WhatsApp handoff.
# Same-origin path proxied by Render to the bot host. Leave as-is unless
# you are pointing at a different backend.
VITE_ASSISTANT_URL=/assistant/chat
VITE_ASSISTANT_KEY=
VITE_WHATSAPP_NUMBER=250729247124
